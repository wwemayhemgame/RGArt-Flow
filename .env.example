# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Studio Administrator Email
ADMIN_EMAIL="ranjeet.patil@zapak.com"

# SMTP Email Server Configuration (For outbound verification and password reset dispatch)
# IceWarp / Reliance Games:
# SMTP_HOST=reliancegames.icewarpcloud.in
# SMTP_PORT=465
# SMTP_USER=ranjeet.patil@zapak.com
# SMTP_PASS=YourIceWarpPassword
# SMTP_SECURE=true
# SMTP_FROM="RG ArtFlow <ranjeet.patil@zapak.com>"

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=ranjeet.patil@zapak.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM="RG ArtFlow <ranjeet.patil@zapak.com>"

# Jira Single-Seat Studio Integration (App-wide Lead Jira Proxy Gateway)
JIRA_HOST_URL="https://reliancegames.atlassian.net"
JIRA_EMAIL="ranjeet.patil@zapak.com"
JIRA_API_TOKEN=""
JIRA_PROJECT_KEYS="WWE, ART, MAYHEM"
